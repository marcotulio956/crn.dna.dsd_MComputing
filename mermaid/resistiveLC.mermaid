flowchart LR

    %% =========================================================
    %% STYLES
    %% =========================================================

    classDef block fill:#ffffff,stroke:#000000,stroke-width:2px;
    classDef signal fill:#ffffff,stroke:#000000,stroke-width:0px;


    %% =========================================================
    %% INPUT VOLTAGE
    %% =========================================================

    Vin["$$v_{\mathrm{in}}^{\pm}$$"]


    %% =========================================================
    %% 1/L * v_in
    %% =========================================================

    INVL["$$\displaystyle\times\frac{1}{L}$$"]

    VIN_TERM["$$\displaystyle    \frac{1}{L}v_{\mathrm{in}}^{\pm}    $$"]


    %% =========================================================
    %% -R/L * i
    %% =========================================================

    RL["$$\displaystyle\times\frac{R}{L}$$"]

    R_TERM["$$\displaystyle    \frac{R}{L}i^{\pm}    $$"]


    %% =========================================================
    %% -1/L * v_C
    %% =========================================================

    INVL_C["$$\displaystyle\times\frac{1}{L}$$"]

    VC_TERM["$$\displaystyle    \frac{1}{L}v_C^{\pm}    $$"]


    %% =========================================================
    %% SUMMATION
    %%
    %% di/dt = v_in/L - Ri/L - v_C/L
    %% =========================================================

    ADD["$$\displaystyle    \frac{di^{\pm}}{dt}    =    \frac{1}{L}v_{\mathrm{in}}^{\pm}    -    \frac{R}{L}i^{\pm}    -   \frac{1}{L}v_C^{\pm}$$"]


    %% =========================================================
    %% CURRENT INTEGRATOR
    %% =========================================================

    INT_I["$$\displaystyle\int dt$$"]

    I["$$i^{\pm}$$"]


    %% =========================================================
    %% CAPACITOR: 1/C * i
    %% =========================================================

    INVC["$$\displaystyle\times\frac{1}{C}$$"]

    I_C_TERM["$$\displaystyle    \frac{1}{C}i^{\pm}    $$"]

    %% =========================================================
    %% VOLTAGE INTEGRATOR
    %% =========================================================

    INT_V["$$\displaystyle\int dt$$"]

    VC["$$v_C^{\pm}$$"]


    %% =========================================================
    %% INPUT PATH
    %% =========================================================

    Vin -->|"$$v_{\mathrm{in}}^{\pm}$$"| INVL

    INVL -->|"$$\displaystyle    \frac{1}{L}v_{\mathrm{in}}^{\pm}    $$"| VIN_TERM
    VIN_TERM --> ADD


    %% =========================================================
    %% RESISTIVE FEEDBACK
    %% =========================================================

    I -->|"$$i^{\pm}$$"| RL

    RL -->|"$$\displaystyle    \frac{R}{L}i^{\pm}    $$"| R_TERM
    R_TERM --> ADD


    %% =========================================================
    %% CAPACITOR FEEDBACK
    %% =========================================================

    VC -->|"$$v_C^{\pm}$$"| INVL_C

    INVL_C -->|"$$\displaystyle    \frac{1}{L}v_C^{\pm}    $$"| VC_TERM

    VC_TERM --> ADD


    %% =========================================================
    %% CURRENT DYNAMICS
    %% =========================================================

    ADD -->|"$$\displaystyle    \frac{di^{\pm}}{dt}    $$"| INT_I

    INT_I -->|"$$i^{\pm}$$"| I


    %% =========================================================
    %% CAPACITOR DYNAMICS
    %% =========================================================

    I -->|"$$i^{\pm}$$"| INVC

    INVC -->|"$$\displaystyle    \frac{1}{C}i^{\pm}    $$"| I_C_TERM

    I_C_TERM -->|"$$\displaystyle    \frac{dv_C^{\pm}}{dt}    $$"| INT_V

    INT_V -->|"$$v_C^{\pm}$$"| VC


    %% =========================================================
    %% CLASSES
    %% =========================================================

    class INVL,RL,INVL_C,ADD,INT_I,INVC,INT_V block;
    class Vin,I,VC,VIN_TERM,R_TERM,VC_TERM,I_C_TERM signal;