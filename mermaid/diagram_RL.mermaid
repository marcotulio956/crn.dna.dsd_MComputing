flowchart LR
    classDef block fill:#ffffff,stroke:#000000,stroke-width:2px;
    classDef signal fill:#ffffff,stroke:#000000,stroke-width:0px;

    Vin["$$v_{\mathrm{in}}^{\pm}$$"]
    I_OUT["$$i_L^{\pm}$$"]
    
    MUL_R["$$\times R$$"]
    VR_TERM["$$v_R^{\pm}$$"]
    
    SUB_VL["$$v_L^{\pm} = v_{\mathrm{in}}^{\pm} - v_R^{\pm}$$"]
    
    MUL_1oL["$$\displaystyle \times \frac{1}{L}$$"]
    DIDT["$$\displaystyle \frac{di_L^{\pm}}{dt}$$"]
    
    INT_I["$$\displaystyle \int dt$$"]

    %% Feedback Loop
    I_OUT -->|"$$i_L^{\pm}$$"| MUL_R
    MUL_R -->|"$$v_R^{\pm}$$"| VR_TERM
    VR_TERM --> SUB_VL
    
    %% Input Routing
    Vin -->|"$$v_{\mathrm{in}}^{\pm}$$"| SUB_VL
    
    %% Dynamics
    SUB_VL -->|"$$v_L^{\pm}$$"| MUL_1oL
    MUL_1oL -->|"$$\displaystyle \frac{di_L^{\pm}}{dt}$$"| DIDT
    DIDT --> INT_I
    INT_I -->|"$$i_L^{\pm}$$"| I_OUT

    class MUL_R,SUB_VL,MUL_1oL,INT_I block;
    class Vin,I_OUT,VR_TERM,DIDT signal;