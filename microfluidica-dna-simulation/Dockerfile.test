# Test Dockerfile - simplified version to test basic setup
FROM ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV R_HOME=/usr/lib/R
ENV R_LIBS_USER=/usr/local/lib/R/site-library

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    r-base \
    r-base-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    poppler-utils \
    build-essential \
    curl \
    wget \
    git \
    libgit2-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libgdal-dev \
    libproj-dev \
    libgeos-dev \
    libudunits2-dev \
    libgsl-dev \
    libxt-dev \
    libcairo2-dev \
    libpango1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and run R package installation script
COPY install_r_packages.R /tmp/install_r_packages.R
COPY test_r_installation.R /tmp/test_r_installation.R
RUN Rscript /tmp/install_r_packages.R && \
    echo "Testing R installation..." && \
    Rscript /tmp/test_r_installation.R

# Set working directory
WORKDIR /app

# Install basic Python packages first (without mmft.simulator)
RUN pip3 install --upgrade pip setuptools wheel && \
    pip3 install fastapi uvicorn matplotlib networkx pdf2image pillow numpy pandas python-multipart

# Copy application files
COPY Python/ ./Python/
COPY DNAr/ ./DNAr/
COPY frontend/new-interface/ ./frontend/

# Build the React frontend
WORKDIR /app/frontend
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    npm install && \
    npm run build

# Switch back to main directory
WORKDIR /app

# Create a startup script
RUN echo '#!/bin/bash\n\
cd /app/Python\n\
uvicorn subprocess_R:app --host 0.0.0.0 --port 8000 --workers 1\n\
' > /app/start.sh && chmod +x /app/start.sh

# Create non-root user for security
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Start the application
CMD ["/app/start.sh"]
