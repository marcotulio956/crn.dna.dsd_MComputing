FROM dnar-dev
ENV DEBIAN_FRONTEND=noninteractive
ENV R_HOME=/usr/local/lib/R
ENV LD_LIBRARY_PATH=/usr/local/lib/R/lib
ENV DNAR_ROOT=/workspaces/dnar
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY microfluidica-dna-simulation/mmft_simulator-0.2.2.dev54+gf6e155442-cp310-cp310-linux_x86_64.whl /tmp/mmft_simulator-0.2.2.dev54+gf6e155442-cp310-cp310-linux_x86_64.whl
COPY microfluidica-dna-simulation/backend/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir /tmp/mmft_simulator-0.2.2.dev54+gf6e155442-cp310-cp310-linux_x86_64.whl -r /tmp/requirements.txt
COPY microfluidica-dna-simulation/backend /app/backend
COPY R /workspaces/dnar/R
CMD ["python3", "-m", "backend.worker", "/run"]
