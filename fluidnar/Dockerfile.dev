FROM dnar-dev

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/app/Python
ENV FLUIDNAR_WORKDIR=/app/Python
ENV DNAR_ROOT=/workspaces/dnar
ENV R_HOME=/usr/local/lib/R
ENV LD_LIBRARY_PATH=/usr/local/lib/R/lib

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    poppler-utils \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY fluidnar/requirements.txt /tmp/fluidnar-requirements.txt
COPY fluidnar/mmft_simulator-0.2.2.dev54+gf6e155442-cp310-cp310-linux_x86_64.whl /tmp/mmft_simulator-0.2.2.dev54+gf6e155442-cp310-cp310-linux_x86_64.whl
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir /tmp/mmft_simulator-0.2.2.dev54+gf6e155442-cp310-cp310-linux_x86_64.whl \
    && python3 -m pip install --no-cache-dir -r /tmp/fluidnar-requirements.txt \
    && rm -f /tmp/mmft_simulator-0.2.2.dev54+gf6e155442-cp310-cp310-linux_x86_64.whl /tmp/fluidnar-requirements.txt

COPY fluidnar/Python/ /app/Python/
COPY fluidnar/DNAr/ /app/DNAr/
COPY fluidnar/frontend/new-interface/build/ /app/frontend/new-interface/build/

RUN id -u appuser >/dev/null 2>&1 || useradd -m -u 1000 appuser \
    && mkdir -p /app/Python \
    && chown -R appuser:appuser /app

USER appuser
WORKDIR /app/Python

CMD ["python3", "-m", "uvicorn", "subprocess_R:app", "--host", "0.0.0.0", "--port", "8000"]
